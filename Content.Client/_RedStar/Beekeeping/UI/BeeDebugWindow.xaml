<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:botany="clr-namespace:Content.Client.Botany.UI"
                      Title="{Loc beekeeping-debug-window-title}"
                      MinWidth="760"
                      MinHeight="440">
    <BoxContainer Orientation="Horizontal"
                  Margin="6 4 6 8"
                  SeparationOverride="6"
                  VerticalExpand="True">

        <!-- The hive. No MaxWidth: the column grows to fit the longest name and value. -->
        <PanelContainer StyleClasses="PanelInsetDark">
            <BoxContainer Orientation="Vertical"
                          MinWidth="280"
                          VerticalExpand="True"
                          Margin="6"
                          SeparationOverride="4">
                <Label Name="HiveName"
                       StyleClasses="LabelKeyText"
                       HorizontalAlignment="Center" />
                <SpriteView Name="HiveSprite"
                            OverrideDirection="South"
                            Scale="2 2"
                            SetSize="64 64"
                            HorizontalAlignment="Center" />

                <PanelContainer StyleClasses="BackgroundPanel"
                                HorizontalExpand="True">
                    <BoxContainer Orientation="Vertical" Margin="0 8">
                        <Label Text="{Loc beekeeping-debug-section-colony}"
                               StyleClasses="LabelKeyText" />
                        <GridContainer Columns="2" HorizontalExpand="True">
                            <Label Text="{Loc beekeeping-debug-queen}" Margin="0 0 8 0" />
                            <Label Name="Queen" StyleClasses="LabelWeak" />
                            <Label Text="{Loc beekeeping-debug-outside}" Margin="0 0 8 0" />
                            <Label Name="Outside" StyleClasses="LabelWeak" />
                            <Label Text="{Loc beekeeping-debug-pause}" Margin="0 0 8 0" />
                            <Label Name="Pause" StyleClasses="LabelWeak" />
                            <Label Text="{Loc beekeeping-debug-scout}" Margin="0 0 8 0" />
                            <Label Name="Scout" StyleClasses="LabelWeak" />
                            <Label Name="FoundLabel" Text="{Loc beekeeping-debug-scout-found}" Margin="0 0 8 0" Visible="False" />
                            <Label Name="Found" StyleClasses="LabelWeak" Visible="False" />
                            <Label Text="{Loc beekeeping-debug-next-trip}" Margin="0 0 8 0" />
                            <Label Name="NextTrip" StyleClasses="LabelWeak" />
                            <Label Text="{Loc beekeeping-debug-next-forager}" Margin="0 0 8 0" />
                            <Label Name="NextForager" StyleClasses="LabelWeak" />
                            <Label Text="{Loc beekeeping-debug-foragers}" Margin="0 0 8 0" />
                            <Label Name="Foragers" StyleClasses="LabelWeak" />
                            <Label Text="{Loc beekeeping-debug-row-egg}" Margin="0 0 8 0" />
                            <Label Name="Egg" StyleClasses="LabelWeak" />
                        </GridContainer>
                    </BoxContainer>
                </PanelContainer>

                <!-- Long text wraps at the minimum width instead of widening the column. -->
                <PanelContainer StyleClasses="BackgroundPanel"
                                HorizontalExpand="True">
                    <BoxContainer Orientation="Vertical" Margin="0 8" MaxWidth="280">
                        <Label Text="{Loc beekeeping-debug-section-queen}"
                               StyleClasses="LabelKeyText" />
                        <RichTextLabel Name="QueenInfo" />
                    </BoxContainer>
                </PanelContainer>

                <PanelContainer StyleClasses="BackgroundPanel"
                                HorizontalExpand="True"
                                VerticalExpand="True">
                    <BoxContainer Orientation="Vertical" Margin="4 8" MaxWidth="280">
                        <RichTextLabel Name="Legend" />
                    </BoxContainer>
                </PanelContainer>
            </BoxContainer>
        </PanelContainer>

        <!-- Numbers, trays and bees outside -->
        <BoxContainer Orientation="Vertical"
                      HorizontalExpand="True"
                      SeparationOverride="4">
            <PanelContainer StyleClasses="BackgroundPanelDark"
                            HorizontalExpand="True">
                <GridContainer Columns="2"
                               Margin="0 8"
                               VSeparationOverride="6"
                               HSeparationOverride="6"
                               HorizontalExpand="True">
                    <botany:BotanyMetricControl Name="Bees" />
                    <botany:BotanyMetricControl Name="Nectar" />
                    <botany:BotanyMetricControl Name="Combs" />
                    <botany:BotanyMetricControl Name="Health" />
                </GridContainer>
            </PanelContainer>

            <PanelContainer StyleClasses="BackgroundPanelDark"
                            HorizontalExpand="True"
                            VerticalExpand="True">
                <BoxContainer Orientation="Vertical" Margin="0 8">
                    <Label Name="SourcesHeading"
                           StyleClasses="LabelKeyText"
                           Margin="0 0 0 2" />
                    <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                        <BoxContainer Name="Sources"
                                      Orientation="Vertical"
                                      SeparationOverride="4" />
                    </ScrollContainer>
                </BoxContainer>
            </PanelContainer>

            <PanelContainer StyleClasses="BackgroundPanelDark"
                            HorizontalExpand="True">
                <BoxContainer Orientation="Vertical" Margin="0 8">
                    <Label Name="OutsideHeading"
                           StyleClasses="LabelKeyText"
                           Margin="0 0 0 2" />
                    <BoxContainer Name="OutsideBees"
                                  Orientation="Vertical"
                                  SeparationOverride="2" />
                </BoxContainer>
            </PanelContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
